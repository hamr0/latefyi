node_modules/
*.log
poc/logs/

# Runtime state + observability logs (never commit — may hold operational data).
/state/
/logs/
# pulselog config is rendered on the VPS from pulselog.config.template.json
# (see scripts/install-units.sh); the template is committed, the rendered file
# holds $OPERATOR_EMAIL and is not.
/pulselog.config.json
.env
.env.*
!.env.example

.DS_Store
Thumbs.db
*.swp
*~

.idea/
.vscode/
.claude/settings.local.json
.claude/stash/

# Agent / IDE / tooling scratch — ignore EVERY dot-directory by default
# (.claude, .litectx, .idea, .barebrowse, .vscode, and whatever the next tool
# invents), then re-admit only the ones we actually ship. Default-deny beats
# chasing each new scratch dir with its own line.
.*/
!.github/

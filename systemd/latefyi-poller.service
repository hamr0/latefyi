[Unit]
Description=latefyi poll-runner daemon
After=network.target

[Service]
Type=simple
User=latefyi
Group=latefyi
WorkingDirectory=/opt/latefyi
EnvironmentFile=/etc/latefyi.env

# Prevent dual-running. flock holds an exclusive lock on the lockfile for the
# lifetime of the process; -n means fail immediately if held. Combined with
# the kill in ExecStartPre (which catches orphans started outside systemd),
# this guarantees exactly one poll-runner per host. The May 2026 bug where
# two daemons raced on state/active/ — old one wrote plaintext sender to
# push.jsonl and dropped sends silently — would have been impossible.
ExecStartPre=-/usr/bin/pkill -f /opt/latefyi/src/poll-runner.js
ExecStart=/usr/bin/flock -n /run/latefyi-poller.lock /usr/bin/node src/poll-runner.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/latefyi /run
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=latefyi health check (pulselog) — services, ingest API, disk, SSL, mail queue
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=latefyi
Group=latefyi
WorkingDirectory=/opt/latefyi
EnvironmentFile=/etc/latefyi.env
# Silent on green; writes one line per failure to logs/health.jsonl and sends
# ONE summary email to $OPERATOR_EMAIL when anything fails. Config is rendered
# from pulselog.config.template.json by scripts/install-units.sh.
ExecStart=/usr/bin/node node_modules/pulselog/bin/pulselog.js --config /opt/latefyi/pulselog.config.json
Nice=10

NoNewPrivileges=true
ProtectSystem=strict
# pulselog mails via mailx -> postdrop, which is setgid postdrop and writes the
# maildrop spool. NoNewPrivileges disables setgid, so grant the group directly
# and open the spool, or every alert fails silently (postdrop: Permission denied).
SupplementaryGroups=postdrop
ReadWritePaths=/opt/latefyi /var/spool/postfix/maildrop
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
